<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<resource xmlns="http://www.wxwidgets.org/wxxrc" version="2.5.3.0">
  <object class="wxPanel" name="RoadGeneratorMainPanel">
    <style>wxTAB_TRAVERSAL</style>
    <object class="wxBoxSizer" name="">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <flag>wxALL</flag>
        <border>12</border>
        <option>0</option>
        <object class="wxStaticText" name="RoadGeneratorTopLabel">
          <label>Generate Road Network</label>
          <wrap>-1</wrap>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
        <border>12</border>
        <option>0</option>
        <object class="wxStaticBoxSizer" name="">
          <orient>wxVERTICAL</orient>
          <label>Carriageway</label>
      <object class="sizeritem">
        <flag>wxBOTTOM|wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <option>0</option>
        <object class="wxFlexGridSizer" name="">
          <vgap>6</vgap>
          <hgap>12</hgap>
          <growablerows></growablerows>
          <growablecols>1,3</growablecols>
          <rows>2</rows>
          <cols>4</cols>
      <object class="sizeritem">
        <flag>wxALIGN_CENTER_VERTICAL</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxStaticText" name="">
          <label>Subdivisions:</label>
          <wrap>0</wrap>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxSpinCtrl" name="RoadGeneratorSubdivisions">
          <value>8</value>
          <min>1</min>
          <max>64</max>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxALIGN_CENTER_VERTICAL</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxStaticText" name="">
          <label>Lanes:</label>
          <wrap>0</wrap>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxSpinCtrl" name="RoadGeneratorLanes">
          <value>2</value>
          <min>1</min>
          <max>12</max>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxALIGN_CENTER_VERTICAL</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxStaticText" name="">
          <label>Lane Width:</label>
          <wrap>0</wrap>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxTextCtrl" name="RoadGeneratorLaneWidth">
          <value>128</value>
          <maxlength>0</maxlength>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxStaticText" name="">
          <label></label>
          <wrap>0</wrap>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxStaticText" name="">
          <label></label>
          <wrap>0</wrap>
        </object>
      </object>
        </object>
      </object>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
        <border>12</border>
        <option>0</option>
        <object class="wxStaticBoxSizer" name="">
          <orient>wxVERTICAL</orient>
          <label>Sidewalk</label>
      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <option>0</option>
        <object class="wxCheckBox" name="RoadGeneratorSidewalk">
          <label>Generate sidewalks</label>
          <checked>1</checked>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxBOTTOM|wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <option>0</option>
        <object class="wxFlexGridSizer" name="">
          <vgap>6</vgap>
          <hgap>12</hgap>
          <growablerows></growablerows>
          <growablecols>1,3</growablecols>
          <rows>2</rows>
          <cols>4</cols>
      <object class="sizeritem">
        <flag>wxALIGN_CENTER_VERTICAL</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxStaticText" name="">
          <label>Width:</label>
          <wrap>0</wrap>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxTextCtrl" name="RoadGeneratorSidewalkWidth">
          <value>96</value>
          <maxlength>0</maxlength>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxALIGN_CENTER_VERTICAL</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxStaticText" name="">
          <label>Height Above Road:</label>
          <wrap>0</wrap>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxTextCtrl" name="RoadGeneratorSidewalkHeight">
          <value>16</value>
          <maxlength>0</maxlength>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxALIGN_CENTER_VERTICAL</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxStaticText" name="">
          <label>Curb:</label>
          <wrap>0</wrap>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>0</border>
        <option>1</option>
        <object class="wxChoice" name="RoadGeneratorCurbStyle">
          <selection>0</selection>
          <content>
            <item>Square</item>
            <item>Round</item>
          </content>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxALIGN_CENTER_VERTICAL</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxStaticText" name="">
          <label>Curb Radius:</label>
          <wrap>0</wrap>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxTextCtrl" name="RoadGeneratorCurbRadius">
          <value>8</value>
          <maxlength>0</maxlength>
        </object>
      </object>
        </object>
      </object>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
        <border>12</border>
        <option>0</option>
        <object class="wxStaticBoxSizer" name="">
          <orient>wxVERTICAL</orient>
          <label>Intersections</label>
      <object class="sizeritem">
        <flag>wxBOTTOM|wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <option>0</option>
        <object class="wxFlexGridSizer" name="">
          <vgap>6</vgap>
          <hgap>12</hgap>
          <growablerows></growablerows>
          <growablecols>1,3</growablecols>
          <rows>1</rows>
          <cols>4</cols>
      <object class="sizeritem">
        <flag>wxALIGN_CENTER_VERTICAL</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxStaticText" name="">
          <label>Corner:</label>
          <wrap>0</wrap>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>0</border>
        <option>1</option>
        <object class="wxChoice" name="RoadGeneratorCornerStyle">
          <selection>1</selection>
          <content>
            <item>Square</item>
            <item>Round</item>
          </content>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxALIGN_CENTER_VERTICAL</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxStaticText" name="">
          <label>Corner Radius:</label>
          <wrap>0</wrap>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxTextCtrl" name="RoadGeneratorCornerRadius">
          <value>64</value>
          <maxlength>0</maxlength>
        </object>
      </object>
        </object>
      </object>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
        <border>12</border>
        <option>0</option>
        <object class="wxStaticBoxSizer" name="">
          <orient>wxVERTICAL</orient>
          <label>Materials</label>
      <object class="sizeritem">
        <flag>wxBOTTOM|wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
        <border>12</border>
        <option>0</option>
        <object class="wxFlexGridSizer" name="">
          <vgap>6</vgap>
          <hgap>12</hgap>
          <growablerows></growablerows>
          <growablecols>1</growablecols>
          <rows>3</rows>
          <cols>3</cols>
      <object class="sizeritem">
        <flag>wxALIGN_CENTER_VERTICAL</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxStaticText" name="">
          <label>Road:</label>
          <wrap>0</wrap>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxTextCtrl" name="RoadGeneratorMaterial">
          <value>textures/common/caulk</value>
          <maxlength>0</maxlength>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxLEFT</flag>
        <border>6</border>
        <option>0</option>
        <object class="wxButton" name="RoadGeneratorBrowseMaterial">
          <size>30,-1</size>
          <label>...</label>
          <default>0</default>
          <auth_needed>0</auth_needed>
          <markup>0</markup>
          <bitmap/>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxALIGN_CENTER_VERTICAL</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxStaticText" name="">
          <label>Sidewalk:</label>
          <wrap>0</wrap>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxTextCtrl" name="RoadGeneratorSidewalkMaterial">
          <value>textures/common/caulk</value>
          <maxlength>0</maxlength>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxLEFT</flag>
        <border>6</border>
        <option>0</option>
        <object class="wxButton" name="RoadGeneratorBrowseSidewalkMaterial">
          <size>30,-1</size>
          <label>...</label>
          <default>0</default>
          <auth_needed>0</auth_needed>
          <markup>0</markup>
          <bitmap/>
